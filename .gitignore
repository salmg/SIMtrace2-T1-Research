# ---------------------------------------------------------------------------
# Firmware build output.
#
# NOTE the firmware Makefiles ARE sources and must stay tracked, as are the
# Atmel prebuilt libchip/libusb .a files -- the build links against them.
# So nothing here may be a blanket "Makefile" or "*.a" pattern.
# ---------------------------------------------------------------------------
firmware/bin/
firmware/test/card_emu_test
firmware/test/card_emu_t1_test
# Generated per BOARD/APP by firmware/Makefile:253 and upstream does not track
# it. Tracking it makes every build dirty the tree, which then stamps the NEXT
# build "-dirty" -- and the copy that came with this tree was a qmod build, so
# it was wrong for this board as well.
firmware/apps/*/usb_strings_generated.h
*.o
*.d
*.hobj
*.elf
*.map
*.patched

# ---------------------------------------------------------------------------
# host/ autotools and libtool output. host/**/Makefile.am are sources;
# everything below is generated by autoreconf, configure or make.
# ---------------------------------------------------------------------------
host/Makefile
host/Makefile.in
host/*/Makefile
host/*/Makefile.in
host/*/*/Makefile
host/*/*/Makefile.in
host/aclocal.m4
host/autom4te.cache/
host/compile
host/config.guess
host/config.h
host/config.h.in
host/config.log
host/config.status
host/config.sub
host/configure
host/depcomp
host/install-sh
host/libtool
host/ltmain.sh
host/missing
host/stamp-h1
host/test-driver
host/**/.libs/
host/**/.deps/
host/**/*.la
host/**/*.lo
host/**/*.a
host/**/*.so
host/**/*.so.*
host/libosmocore/

# Python / editor noise
__pycache__/
*.pyc
